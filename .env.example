# Public Web3Forms key and hCaptcha site key required to submit the contact form.
# hCaptcha must be configured for the production domain; use email if unavailable.
VITE_WEB3FORMS_ACCESS_KEY=
VITE_HCAPTCHA_SITE_KEY=

# Server-only Typecast TTS configuration (never use the VITE_ prefix)
TYPECAST_API_KEY=
TYPECAST_VOICE_ID=

# Shared rate limiting for the public TTS endpoint
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
